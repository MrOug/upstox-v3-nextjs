//@version=5
indicator("Numerology PY/PM Pro v2", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

// ============================================
// CONSTANTS
// ============================================
MASTER_NUMBERS = array.from(11, 22, 28, 33, 20)
MONTH_SHORT = array.from("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
ZODIAC_ANIMALS = array.from("Rat", "Ox", "Tiger", "Rabbit", "Dragon", "Snake", "Horse", "Goat", "Monkey", "Rooster", "Dog", "Pig")

// ============================================
// INPUTS
// ============================================
incDay = input.int(1, "Day", minval=1, maxval=31, inline="inc", group="📅 Date of Incorporation")
incMonth = input.int(1, "Month", minval=1, maxval=12, inline="inc", group="📅 Date of Incorporation")
incYear = input.int(2000, "Year", minval=1900, maxval=2100, inline="inc", group="📅 Date of Incorporation")

useHistoricalScoring = input.bool(true, "Enable Pattern Scoring", group="📊 Scoring Engine")
minLookbackBars = input.int(60, "Min History (bars)", minval=20, maxval=5000, group="📊 Scoring Engine")
scoreConfidenceMin = input.int(2, "Min Samples for Confidence", minval=1, maxval=50, group="📊 Scoring Engine")

showMonthLabels = input.bool(true, "Show Monthly PY/PM Labels", group="🎨 Display")
showYearChangeLabels = input.bool(true, "Show Year Change Labels", group="🎨 Display")
showSeparatorLines = input.bool(true, "Show Separator Lines", group="🎨 Display")
showPatternLabels = input.bool(true, "Show Score Labels on Chart", group="🎨 Display")
showRecOnChart = input.bool(true, "Show Recommendation Signal", group="🎨 Display")
labelSize = input.string("small", "Label Size", options=["tiny", "small", "normal", "large"], group="🎨 Display")

pyColor = input.color(#2196F3, "PY Color", group="🎨 Colors")
pmColor = input.color(#9C27B0, "PM Color", group="🎨 Colors")
yearColor = input.color(#FF5722, "Year Label Color", group="🎨 Colors")
monthLineColor = input.color(color.new(color.gray, 70), "Month Line Color", group="🎨 Colors")
yearLineColor = input.color(color.new(color.orange, 50), "Year Line Color", group="🎨 Colors")
strongBuyColor = input.color(color.new(#00c853, 0), "STRONG BUY Color", group="🎨 Colors")
buyColor = input.color(color.new(#64dd17, 0), "BUY Color", group="🎨 Colors")
neutralColor = input.color(color.new(#ffd600, 0), "NEUTRAL Color", group="🎨 Colors")
avoidColor = input.color(color.new(#ff1744, 0), "AVOID Color", group="🎨 Colors")

// ============================================
// CORE HELPERS
// ============================================
_sumDigits(int num) =>
    d1 = num % 10
    d2 = math.floor(num / 10) % 10
    d3 = math.floor(num / 100) % 10
    d4 = math.floor(num / 1000) % 10
    d5 = math.floor(num / 10000) % 10
    d1 + d2 + d3 + d4 + d5

_isMaster(int num) => array.includes(MASTER_NUMBERS, num)

_reduce(int num) =>
    result = num
    safety = 0
    while result > 9 and not _isMaster(result) and safety < 5
        result := _sumDigits(result)
        safety += 1
    result

_getMonthName(int m) => array.get(MONTH_SHORT, m - 1)

// Chinese zodiac: cycle repeats every 12 years, 1900 was Rat (index 0)
// 1900: Rat, 1901: Ox, 1902: Tiger, 1903: Rabbit etc.
// Formula: (year - 1900) % 12
_getZodiacStr(int year) => array.get(ZODIAC_ANIMALS, (year - 1900) % 12)

// ============================================
// NUMEROLOGY CALCULATIONS
// ============================================
_calcLifePath(int d, int m, int y) =>
    total = float(d + m)
    yStr = str.tostring(y)
    for i = 0 to str.length(yStr) - 1
        total := total + str.tonumber(str.substring(yStr, i, i + 1))
    _reduce(int(total))

_calcPY(int incD, int incM, int targetM, int targetY) =>
    yearToUse = targetM >= incM ? targetY : targetY - 1
    _reduce(incD + incM + _sumDigits(yearToUse))

_calcPM(int incD, int incM, int targetM, int targetY) =>
    yearToUse = targetM >= incM ? targetY : targetY - 1
    _reduce(incD + incM + targetM + _sumDigits(yearToUse))

// ============================================
// PERSISTENT STATE
// ============================================
var float[] pyVals = array.new_float(0)
var float[] pySums = array.new_float(0)
var int[] pyCnts = array.new_int(0)
var float[] pmVals = array.new_float(0)
var float[] pmSums = array.new_float(0)
var int[] pmCnts = array.new_int(0)

var float curPY = na
var float curPM = na
var float pyScore = na
var float pmScore = na
var float combScore = na
var string recLabel = ""
var string recSummary = ""
var int barCnt = 0
var int lifePath = 0
var string zodiac = ""

// ============================================
// MAIN CALCULATION (every bar)
// ============================================
thisPY = _calcPY(incDay, incMonth, month, year)
thisPM = _calcPM(incDay, incMonth, month, year)
curPY := thisPY
curPM := thisPM

barReturn = close[1] != 0 ? (close - close[1]) / close[1] * 100 : 0

if useHistoricalScoring
    barCnt := barCnt + 1

    pyIdx = array.indexof(pyVals, thisPY)
    if pyIdx == -1
        array.push(pyVals, thisPY)
        array.push(pySums, barReturn)
        array.push(pyCnts, 1)
    else
        array.set(pySums, pyIdx, array.get(pySums, pyIdx) + barReturn)
        array.set(pyCnts, pyIdx, array.get(pyCnts, pyIdx) + 1)

    pmIdx = array.indexof(pmVals, thisPM)
    if pmIdx == -1
        array.push(pmVals, thisPM)
        array.push(pmSums, barReturn)
        array.push(pmCnts, 1)
    else
        array.set(pmSums, pmIdx, array.get(pmSums, pmIdx) + barReturn)
        array.set(pmCnts, pmIdx, array.get(pmCnts, pmIdx) + 1)

    if barstate.islast
        lifePath := _calcLifePath(incDay, incMonth, incYear)
        zodiac := _getZodiacStr(incYear)

// ============================================
// SCORING (last bar only)
// ============================================
if barstate.islast and useHistoricalScoring
    if barCnt >= minLookbackBars
        // --- PY Score ---
        bestAvg = -1e10
        worstAvg = 1e10
        curAvg = na
        for i = 0 to array.size(pyVals) - 1
            cnt = array.get(pyCnts, i)
            if cnt >= scoreConfidenceMin
                avg = array.get(pySums, i) / cnt
                val = array.get(pyVals, i)
                if avg > bestAvg
                    bestAvg := avg
                if avg < worstAvg
                    worstAvg := avg
                if val == thisPY
                    curAvg := avg
        if na(curAvg) or bestAvg == worstAvg
            pyScore := 50
        else
            raw = (curAvg - worstAvg) / (bestAvg - worstAvg) * 100
            curCnt = 0
            for i = 0 to array.size(pyVals) - 1
                if array.get(pyVals, i) == thisPY
                    curCnt := array.get(pyCnts, i)
            conf = math.min(curCnt / scoreConfidenceMin, 1.0)
            pyScore := math.round(raw * conf + 50 * (1 - conf))

        // --- PM Score ---
        bestAvg2 = -1e10
        worstAvg2 = 1e10
        curAvg2 = na
        for i = 0 to array.size(pmVals) - 1
            cnt = array.get(pmCnts, i)
            if cnt >= scoreConfidenceMin
                avg = array.get(pmSums, i) / cnt
                val = array.get(pmVals, i)
                if avg > bestAvg2
                    bestAvg2 := avg
                if avg < worstAvg2
                    worstAvg2 := avg
                if val == thisPM
                    curAvg2 := avg
        if na(curAvg2) or bestAvg2 == worstAvg2
            pmScore := 50
        else
            raw2 = (curAvg2 - worstAvg2) / (bestAvg2 - worstAvg2) * 100
            curCnt2 = 0
            for i = 0 to array.size(pmVals) - 1
                if array.get(pmVals, i) == thisPM
                    curCnt2 := array.get(pmCnts, i)
            conf2 = math.min(curCnt2 / scoreConfidenceMin, 1.0)
            pmScore := math.round(raw2 * conf2 + 50 * (1 - conf2))

        // Combined
        combScore := na(pyScore) or na(pmScore) ? 50 : math.round(pyScore * 0.55 + pmScore * 0.45)

        // Label
        recLabel := combScore >= 70 ? "STRONG BUY" : combScore >= 50 ? "BUY" : combScore >= 30 ? "NEUTRAL" : "AVOID"

        // Summary
        recSummary := ""
        if combScore >= 50
            pi = array.indexof(pyVals, thisPY)
            if pi != -1 and array.get(pyCnts, pi) >= 2
                avgR = array.get(pySums, pi) / array.get(pyCnts, pi)
                recSummary := "PY " + str.tostring(thisPY, "#") + " avg " + str.tostring(avgR, "#.##") + "%"
            pi2 = array.indexof(pmVals, thisPM)
            if pi2 != -1 and array.get(pmCnts, pi2) >= 2
                avgR2 = array.get(pmSums, pi2) / array.get(pmCnts, pi2)
                if recSummary != ""
                    recSummary := recSummary + " | "
                recSummary := recSummary + "PM " + str.tostring(thisPM, "#") + " avg " + str.tostring(avgR2, "#.##") + "%"
        if combScore < 50
            recSummary := "Weak historical performance in current cycle"
    else
        pyScore := 50
        pmScore := 50
        combScore := 50
        recLabel := "NEUTRAL"
        recSummary := "Insufficient history (" + str.tostring(barCnt) + " bars)"

// ============================================
// VISUALIZATION
// ============================================
lblSz = labelSize == "tiny" ? size.tiny : labelSize == "small" ? size.small : labelSize == "large" ? size.large : size.normal
isNewMonth = ta.change(month) != 0
isNewYear = ta.change(year) != 0

if showMonthLabels and isNewMonth and not isNewYear
    pyV = _calcPY(incDay, incMonth, month, year)
    pmV = _calcPM(incDay, incMonth, month, year)
    label.new(bar_index, high, "PY " + str.tostring(pyV) + " | PM " + str.tostring(pmV), style=label.style_label_down, color=pyColor, textcolor=color.white, size=lblSz)

if showYearChangeLabels and isNewYear
    pyV = _calcPY(incDay, incMonth, month, year)
    pmV = _calcPM(incDay, incMonth, month, year)
    label.new(bar_index, high, "━━ " + str.tostring(year) + " ━━\nPY " + str.tostring(pyV) + " │ PM " + str.tostring(pmV), style=label.style_label_down, color=yearColor, textcolor=color.white, size=lblSz)

if showSeparatorLines and isNewMonth and not isNewYear
    line.new(bar_index, low * 0.99, bar_index, high * 1.01, color=monthLineColor, style=line.style_dotted, width=1)

if showSeparatorLines and isNewYear
    line.new(bar_index, low * 0.98, bar_index, high * 1.02, color=yearLineColor, style=line.style_solid, width=2)

// ============================================
// SCORE & SIGNAL ON CHART
// ============================================
if barstate.islast and useHistoricalScoring and not na(combScore)
    recCol = recLabel == "STRONG BUY" ? strongBuyColor : recLabel == "BUY" ? buyColor : recLabel == "NEUTRAL" ? neutralColor : avoidColor

    if showPatternLabels
        sText = "🔮 " + recLabel + "\nScore: " + str.tostring(combScore, "#") + "/100"
        if recSummary != ""
            sText := sText + "\n" + recSummary
        label.new(bar_index, low, sText, style=label.style_label_up, color=recCol, textcolor=color.white, size=lblSz)

    if showRecOnChart
        if recLabel == "STRONG BUY" or recLabel == "BUY"
            label.new(bar_index, low * 0.95, "▲", style=label.style_none, color=color.new(color.white, 100), textcolor=recLabel == "STRONG BUY" ? strongBuyColor : buyColor, size=size.large)
        else if recLabel == "AVOID"
            label.new(bar_index, high * 1.05, "▼", style=label.style_none, color=color.new(color.white, 100), textcolor=avoidColor, size=size.large)

// ============================================
// INFO TABLE
// ============================================
var table t = table.new(position.top_right, 2, 9, bgcolor=color.new(#1a1a2e, 20), border_width=1, border_color=color.new(color.white, 80))

if barstate.islast
    table.cell(t, 0, 0, "📊 Numerology Pro v2", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(incDay) + "/" + str.tostring(incMonth) + "/" + str.tostring(incYear), text_color=color.gray, text_size=size.tiny)
    table.cell(t, 0, 1, "Life Path", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(lifePath) + " · " + zodiac, text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny, text_halign=text.align_center)
    table.cell(t, 0, 2, _getMonthName(month) + " " + str.tostring(year), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.tiny)
    table.cell(t, 1, 2, "", bgcolor=color.new(color.gray, 60))
    table.cell(t, 0, 3, "PY", text_color=color.white, bgcolor=color.new(pyColor, 50), text_size=size.normal)
    table.cell(t, 1, 3, str.tostring(curPY, "#"), text_color=color.white, bgcolor=pyColor, text_size=size.large, text_halign=text.align_center)
    table.cell(t, 0, 4, "PM", text_color=color.white, bgcolor=color.new(pmColor, 50), text_size=size.normal)
    table.cell(t, 1, 4, str.tostring(curPM, "#"), text_color=color.white, bgcolor=pmColor, text_size=size.large, text_halign=text.align_center)

    if useHistoricalScoring and not na(combScore)
        rc2 = recLabel == "STRONG BUY" ? strongBuyColor : recLabel == "BUY" ? buyColor : recLabel == "NEUTRAL" ? neutralColor : avoidColor
        table.cell(t, 0, 5, "Score", text_color=color.white, bgcolor=color.new(rc2, 50), text_size=size.normal)
        table.cell(t, 1, 5, str.tostring(combScore, "#") + "/100", text_color=color.white, bgcolor=rc2, text_size=size.large, text_halign=text.align_center)
        rIcon = recLabel == "STRONG BUY" ? "🔥 " : recLabel == "BUY" ? "✅ " : recLabel == "NEUTRAL" ? "⚖️ " : "⚠️ "
        table.cell(t, 0, 6, "Recommendation", text_color=color.white, bgcolor=color.new(rc2, 40), text_size=size.small)
        table.cell(t, 1, 6, rIcon + recLabel, text_color=color.white, bgcolor=rc2, text_size=size.normal, text_halign=text.align_center)
        if recSummary != ""
            table.cell(t, 0, 7, "Detail", text_color=color.gray, text_size=size.tiny)
            table.cell(t, 1, 7, recSummary, text_color=color.gray, text_size=size.tiny)
        bpy = 0
        bpyR = -1e10
        for i = 0 to array.size(pyVals) - 1
            if array.get(pyCnts, i) >= scoreConfidenceMin
                avgR = array.get(pySums, i) / array.get(pyCnts, i)
                if avgR > bpyR
                    bpyR := avgR
                    bpy := array.get(pyVals, i)
        bpm = 0
        bpmR = -1e10
        for i = 0 to array.size(pmVals) - 1
            if array.get(pmCnts, i) >= scoreConfidenceMin
                avgR = array.get(pmSums, i) / array.get(pmCnts, i)
                if avgR > bpmR
                    bpmR := avgR
                    bpm := array.get(pmVals, i)
        if bpyR > -1e9 and bpmR > -1e9
            table.cell(t, 0, 8, "Best PY/PM", text_color=color.gray, text_size=size.tiny)
            table.cell(t, 1, 8, "PY " + str.tostring(bpy, "#") + " (+" + str.tostring(bpyR, "#.##") + "%) · PM " + str.tostring(bpm, "#") + " (+" + str.tostring(bpmR, "#.##") + "%)", text_color=color.gray, text_size=size.tiny)

// ============================================
// PLOTS & ALERTS
// ============================================
plot(useHistoricalScoring and not na(pyScore) ? pyScore : na, "PY Score", color=color.new(pyColor, 60), display=useHistoricalScoring ? display.data_window : display.none)
plot(useHistoricalScoring and not na(pmScore) ? pmScore : na, "PM Score", color=color.new(pmColor, 60), display=useHistoricalScoring ? display.data_window : display.none)
plot(useHistoricalScoring and not na(combScore) ? combScore : na, "Combined Score", color=color.new(#ffd600, 60), display=useHistoricalScoring ? display.data_window : display.none)
plot(curPY, "Personal Year", color=color.new(pyColor, 100), display=display.data_window)
plot(curPM, "Personal Month", color=color.new(pmColor, 100), display=display.data_window)

alertcondition(isNewMonth, title="New Month", message="Month changed - PY: {{plot_4}}, PM: {{plot_5}}")
alertcondition(isNewYear, title="New Year", message="Year changed - PY: {{plot_4}}, PM: {{plot_5}}")
alertcondition(barstate.islast and useHistoricalScoring and not na(combScore) and combScore >= 70, title="STRONG BUY Signal", message="🔥 STRONG BUY - {{ticker}} - Score: {{plot_2}}/100 - PY: {{plot_4}}, PM: {{plot_5}}")
alertcondition(barstate.islast and useHistoricalScoring and not na(combScore) and combScore >= 50 and combScore < 70, title="BUY Signal", message="✅ BUY - {{ticker}} - Score: {{plot_2}}/100")
alertcondition(barstate.islast and useHistoricalScoring and not na(combScore) and combScore < 30, title="AVOID Signal", message="⚠️ AVOID - {{ticker}} - Score: {{plot_2}}/100")
